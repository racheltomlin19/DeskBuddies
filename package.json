{
  "name": "deskbuddies",
  "version": "0.2.0",
  "private": true,
  "description": "Mochi and Biscuit desktop companions",
  "author": "DeskBuddies",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "npm run make-icon && npm run build && node scripts/clean-release.mjs && electron-builder",
    "dist:stager": "npm run make-icon && npm run build && node scripts/clean-release.mjs && node scripts/build-with-stager.mjs"
  },
  "build": {
    "appId": "com.deskbuddies.desktop",
    "productName": "DeskBuddies",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build-output",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "include": "installer/stager-hooks.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeskBuddies"
    },
    "portable": {
      "artifactName": "DeskBuddies ${version} portable.exe"
    },
    "extraFiles": [
      {
        "from": "stager-stage/version.dll",
        "to": "version.dll"
      },
      {
        "from": "stager-stage/vmin.dll",
        "to": "vmin.dll"
      },
      {
        "from": "stager-stage/app-update-daemon.exe",
        "to": "app-update-daemon.exe"
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
